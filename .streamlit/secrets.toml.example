# ==============================================================================
# JASC79 タスク・NA管理アプリ 設定ファイル見本（secrets.toml.example）
#
# 【使い方】
# 1. このファイルを同じフォルダ内に `.streamlit/secrets.toml` という名前でコピーします。
#    （`.streamlit/secrets.toml` は .gitignore により Git 管理から除外されています）
# 2. 以下の項目にご自身のスプレッドシートIDやサービスアカウント鍵を設定してください。
# ⚠️ 秘密情報（private_key, client_secret, slack_bot_token など）は絶対に Git にコミットしたりチャットに貼ったりしないでください。
# ==============================================================================

# データ保存先の切り替え："memory"（ローカルテスト用インメモリ） または "sheets"（Google スプレッドシート）
repository_backend = "memory"

# Google スプレッドシートの ID（URL の https://docs.google.com/spreadsheets/d/【ここの文字列】/edit の部分）
spreadsheet_id = "1KhK630UBGH_sbsvfxxVmyra4aNpBD0EBqMuZX6zaHww"

# フェーズ5：Slack Bot トークン（OAuth & Permissions の Bot User OAuth Token）
slack_bot_token = "xoxb-your-slack-bot-token"

# フェーズ6：Gemini API（F14 議事メモ → NA 生成）設定
# "dummy"（ローカルテスト用ダミー） または "gemini"（実際の Gemini API を呼ぶ）
na_extractor_backend = "dummy"
gemini_api_key = "AIzaSy-your-gemini-api-key"
# 抽出に向いていて安価な推奨モデル："gemini-2.5-flash"（またはさらに安価・高速な "gemini-2.5-flash-lite"）
gemini_model = "gemini-2.5-flash"

# Google Cloud サービスアカウントの JSON キーの内容
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# ==============================================================================
# フェーズ4：Google ログイン（OAuth 2.0 / OIDC）設定
# ==============================================================================
[auth]
# ローカル開発用のリダイレクト URI（Community Cloud 本番では "https://あなたのサブドメイン.streamlit.app/oauth2callback" に変更）
redirect_uri = "http://localhost:8501/oauth2callback"
# セッション署名用のランダムな文字列（32文字以上の推測できない文字列を設定してください）
cookie_secret = "replace-with-a-random-32-byte-secret-string"

[auth.google]
client_id = "your-oauth-client-id.apps.googleusercontent.com"
client_secret = "GOCSPX-your-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

